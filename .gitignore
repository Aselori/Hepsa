.DS_Store
Thumbs.db
.idea/
*.iml
.env
.env.*
!.env.example
*.log
node_modules/
dist/
build/
coverage/
*.tmp
*.bak

# Respaldos de base de datos: contienen datos reales de clientes y hashes
# de contraseñas. Nunca deben entrar al repositorio.
*.backup
*.backup.gz
*.dump
*.sql.gz
db_cluster-*

# Capturas que generan las pruebas de Playwright
tests/screenshots/

# Herramientas locales del agente. Las skills se reinstalan desde
# skills-lock.json, asi que el contenido vendorizado no se versiona.
.agents/
.claude/skills/

# Respaldos y material de trabajo que no forma parte del sitio.
attachments/

# Estado generado por el CLI local; no contiene codigo del proyecto.
supabase/.temp/
supabase/.branches/

# Capturas y ZIP de evidencia. La evidencia del curso vive en la carpeta
# del curso, no en el repositorio de codigo.
output/
